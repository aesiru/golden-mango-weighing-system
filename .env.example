# ============================================================
# Golden Mango Weighing System — Environment Variables Template
# ============================================================
# Copy this file to backend/.env and fill in your own values.
# NEVER commit backend/.env to version control.
#
#   cp .env.example backend/.env
#

# ── Database (required) ──────────────────────────────────────
# PostgreSQL (recommended for production):
DATABASE_URL=postgresql+asyncpg://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/golden_mango_db

# SQLite (for local development without PostgreSQL):
# DATABASE_URL=sqlite+aiosqlite:///./dev.db

# Sync driver (used by Alembic migrations — auto-derived if omitted):
# DATABASE_URL_SYNC=postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@localhost:5432/golden_mango_db

# ── Security (required) ───────────────────────────────────────
# Generate a strong random key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS ─────────────────────────────────────────────────────
# JSON array of allowed frontend origins
# CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# ── Email / SMTP (optional) ─────────────────────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USE_TLS=true
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# EMAIL_FROM_ADDRESS=your-email@gmail.com
# EMAIL_FROM_NAME=Golden Mango Weighing System
# EMAIL_ENABLED=false

# ── File Uploads ─────────────────────────────────────────────
# UPLOAD_DIR=uploads
# MAX_UPLOAD_SIZE_MB=10

# ── Seeds (development only) ────────────────────────────────
# Set to true to insert sample data on startup
# RUN_SEEDS=false

# ── First Admin Account ──────────────────────────────────────
# Created during install via:
# python scripts/setup_system.py --admin-username admin \
#   --admin-email admin@yourdomain.com \
#   --admin-full-name "System Administrator" \
#   --admin-password "change-me-strong-password"
